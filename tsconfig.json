{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "apps/server/**/*.ts",
    "shared/**/*.ts",
    "packages/**/*.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.vue",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
