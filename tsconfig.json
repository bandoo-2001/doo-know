{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "web/**/*.ts",
    "web/**/*.vue",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
