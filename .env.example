# Copy to a local ignored .env; real secrets stay outside source.
# Production must explicitly set all four values below.
KNOWLEDGE_ROOT=/path/to/knowledge
DATA_ROOT=/srv/data/knowledge/doo-know-web
AUTH_SECRET_FILE=/srv/secrets/knowledge/doo-know-web/auth.key
APP_ORIGIN=https://notes.example.invalid
HOST=127.0.0.1
PORT=3010
NODE_ENV=production
AGENT_CONFIG_FILE=/srv/secrets/knowledge/doo-know-web/agent.json
EMBEDDED_FILE_WORKER=1
EMBEDDED_INDEX_WORKER=1
INDEXING_ENABLED=1
INDEX_WATCH=1
# VECTOR_RUNTIME_ROOT=/path/to/released/doo-know-web/runtime/vector-service
# TOKENIZER_PYTHON=/path/to/project/.venv/bin/python
# MODEL_DIR=/srv/models/bge-small-zh-v1.5
# VECTOR_SERVICE_URL=http://127.0.0.1:3081
# VECTOR_SERVICE_TOKEN_FILE=/srv/secrets/knowledge/doo-know-web/vector.token
# EMBEDDING_SPACE_ID=REPLACE_WITH_VERIFIED_MODEL_SPACE_ID
