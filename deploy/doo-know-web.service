# Legacy system-service example; native installs use the generated doo-know user service.
[Unit]
Description=DooKnow private Markdown notes
After=network.target

[Service]
Type=simple
User=bandoo
Group=bandoo
WorkingDirectory=/srv/stacks/knowledge/doo-know-web/app
EnvironmentFile=/srv/secrets/knowledge/doo-know-web/app.env
ExecStart=/usr/bin/node /srv/stacks/knowledge/doo-know-web/app/dist/server/scripts/manage.js serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/data/knowledge/doo-know-web /home/bandoo/workspace/knowledge/knowledge-base
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
