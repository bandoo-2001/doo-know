    "backup:prod": "node dist/server/scripts/backup.js",
    "restore:prod": "node dist/server/scripts/restore.js",
    "git:sync": "tsx scripts/git-sync.ts",
    "worker:file": "tsx scripts/file-worker.ts",
    "worker:index": "tsx scripts/index-worker.ts",
    "index:maintain": "tsx scripts/index-maintain.ts"
