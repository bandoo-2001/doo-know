{
  "name": "doo-know-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "account": "tsx scripts/account.ts",
    "demo": "tsx scripts/demo.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "account:prod": "node dist/server/scripts/account.js",
    "backup:prod": "node dist/server/scripts/backup.js",
    "restore:prod": "node dist/server/scripts/restore.js",
    "git:sync": "tsx scripts/git-sync.ts",
    "worker:file": "tsx scripts/file-worker.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.14",
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "markdown-it": "^15.0.2",
    "naive-ui": "^2.45.3",
    "sanitize-html": "^2.18.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "3.8.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
