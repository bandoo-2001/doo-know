  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "predev": "node scripts/build-process-runner.mjs",
    "prebuild": "node scripts/build-process-runner.mjs",
    "postbuild": "node scripts/build-process-runner.mjs --copy-dist",
    "dev": "tsx scripts/dev.ts",
