{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/server",
    "noEmit": false,
    "rootDir": "."
  },
  "include": [
    "apps/server/**/*.ts",
    "shared/**/*.ts",
    "scripts/account.ts",
    "scripts/manage.ts",
    "scripts/backup.ts",
    "scripts/restore.ts",
    "scripts/git-sync.ts",
    "scripts/file-worker.ts",
    "scripts/index-worker.ts",
    "scripts/index-maintain.ts",
    "packages/core/**/*.ts",
    "scripts/rebind-root.ts",
    "scripts/adopt-bridge.ts",
    "scripts/serve-artifacts.ts"
  ],
  "exclude": [
    "apps/web",
    "tests"
  ]
}
